{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MAWA stack template",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "label", "profile", "runtime", "packageManager", "uiLibrary", "recipes", "patches", "validations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "runtime": { "type": "object", "required": ["node"], "properties": { "node": { "type": "string" } } },
    "packageManager": { "const": "pnpm" },
    "uiLibrary": { "type": "object", "required": ["name", "instructions"], "properties": { "name": { "type": "string" }, "instructions": { "type": "object" } } },
    "recipes": { "type": "array", "items": { "type": "string" } },
    "patches": { "type": "array", "items": { "type": "string" } },
    "validations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
